{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] }
            ]
          },
          "description": "Image pull secrets must be a list (strings or {name: ...} objects), not a bare string. Use --set global.imagePullSecrets[0]=mysecret"
        }
      }
    },
    "signozUpgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "target", "backup", "validation"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["standard", "stage1", "stage2"]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chartVersion", "signozVersion", "otelCollectorVersion", "clickhouseVersion"],
          "properties": {
            "chartVersion": { "type": "string", "enum": ["0.134.0"] },
            "signozVersion": { "type": "string", "enum": ["v0.134.0"] },
            "otelCollectorVersion": { "type": "string", "enum": ["v0.144.6"] },
            "clickhouseVersion": { "type": "string", "enum": ["25.12.5"] }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "volumeSnapshotClassName", "volumeSnapshotClassByStorageClass", "timeout"],
          "properties": {
            "provider": { "type": "string", "enum": ["csi"] },
            "volumeSnapshotClassName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "volumeSnapshotClassByStorageClass": {
              "type": "object",
              "propertyNames": {
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              }
            },
            "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$" }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout", "markerSecretName"],
          "properties": {
            "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$" },
            "markerSecretName": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowSameNamespace": { "type": "boolean" },
        "allowPublicIngress": { "type": "boolean" },
        "allowExternalEgress": { "type": "boolean" },
        "dns": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "extraIngress": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    }
  }
}
