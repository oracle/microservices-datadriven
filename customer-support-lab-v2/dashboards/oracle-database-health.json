            "uid": "${datasource}"
          },
          "expr": "sum by (database, name) (rate(oracledb_activity_value_total{service_name=\"oracledb_exporter\", database=~\"${database:regex}\",name=~\"execute count|parse count .hard.\"}[$__rate_interval]))",
          "legendFormat": "{{database}} \u00b7 {{name}}",
