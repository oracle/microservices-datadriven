    {
      "id": 14,
      "title": "Fast recovery area used",
      "type": "timeseries",
      "description": "No data when no fast recovery area is configured. This is not a measurement of the database container filesystem; archive destinations outside the FRA need separate filesystem monitoring.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * oracledb_recovery_area_used_bytes{service_name=\"oracledb_exporter\",database=\"primary\"} / (oracledb_recovery_area_limit_bytes{service_name=\"oracledb_exporter\",database=\"primary\"} > 0)",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
