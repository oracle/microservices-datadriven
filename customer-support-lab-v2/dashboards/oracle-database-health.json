    {
      "id": 13,
      "title": "PDB tablespace usage",
      "type": "timeseries",
      "description": "Primary application PDB; always shown independently of the instance selector.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "oracledb_tablespace_used_percent{service_name=\"oracledb_exporter\",database=\"primary-pdb\"}",
          "legendFormat": "{{tablespace}}",
          "instant": false,
